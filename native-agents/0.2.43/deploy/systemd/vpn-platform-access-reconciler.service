[Unit]
Description=Reconcile expired and disabled VPN client access
After=network-online.target
[Service]
Type=oneshot
User=vpnplatform
Group=vpnplatform
EnvironmentFile=/etc/vpn-platform/control-plane.env
ExecStart=/opt/vpn-platform/bin/access-reconciler
TimeoutStartSec=55
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
