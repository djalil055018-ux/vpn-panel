[Unit]
Description=VPN Platform Stuck Deployment Observer
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
[Service]
Type=oneshot
User=vpnplatform
Group=vpnplatform
WorkingDirectory=/opt/vpn-platform
EnvironmentFile=/etc/vpn-platform/deployment-observer.env
ExecStart=/opt/vpn-platform/bin/deployment-observer
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077
