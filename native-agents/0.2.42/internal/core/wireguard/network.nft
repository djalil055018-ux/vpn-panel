create table inet vpn_platform_wg
add chain inet vpn_platform_wg input { type filter hook input priority -10; policy accept; }
add chain inet vpn_platform_wg forward { type filter hook forward priority -10; policy accept; }
add chain inet vpn_platform_wg postrouting { type nat hook postrouting priority 100; policy accept; }
add rule inet vpn_platform_wg input iifname "vpnnativewg" drop
add rule inet vpn_platform_wg forward iifname "vpnnativewg" ip daddr { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/4, 240.0.0.0/4 } drop
add rule inet vpn_platform_wg forward iifname "vpnnativewg" ip6 daddr != 2000::/3 drop
add rule inet vpn_platform_wg forward iifname "vpnnativewg" ip6 daddr 2001:db8::/32 drop
add rule inet vpn_platform_wg forward iifname "vpnnativewg" accept
add rule inet vpn_platform_wg forward oifname "vpnnativewg" ct state established,related accept
add rule inet vpn_platform_wg forward oifname "vpnnativewg" drop
add rule inet vpn_platform_wg postrouting iifname "vpnnativewg" masquerade
