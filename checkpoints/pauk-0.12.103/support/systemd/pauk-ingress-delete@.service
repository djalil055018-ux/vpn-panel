[Unit]
Description=PAUK ingress removal request

[Service]
Type=exec
ExecStart=/usr/bin/python3 /usr/local/libexec/pauk-ingress-delete.py
StandardInput=socket
StandardOutput=socket
StandardError=journal
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
UMask=0077
RuntimeMaxSec=11s
